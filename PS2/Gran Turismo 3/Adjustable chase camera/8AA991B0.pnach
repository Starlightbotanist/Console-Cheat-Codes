// -------------------- FIXED CODE --------------------
// Below: fixed code. Leave these lines unchanged.
// Select the editable chase slot even when the car has model-specific cameras.
// The original model-specific bumper camera continues through its native path.
patch=1,EE,00200138,word,1440000C
patch=1,EE,0020013C,word,8E03006C
patch=1,EE,00200140,word,00000000

// Apply pitch before camera-local translation so it does not orbit the car.
// This small helper uses the verified unused gap below this game's executable.
// Camera mode 0 tail-calls the original translation without a pitch adjustment.
